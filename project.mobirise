  "pages": {
    "index.html": {
      "settings": {
        "main": true,
        "title": "Contact Nekkid - Online Content Creator Landing Page",
        "meta_descr": "A dark-themed landing page designed for Nekkid, highlighting contact options and engaging visitors effectively.",
        "header_custom": "",
